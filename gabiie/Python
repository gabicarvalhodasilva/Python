import itertools
import string
import time

def ataque_forca_bruta(senha_alvo, tamanho_maximo=3):
    # Dica 1: Usando um conjunto pequeno de caracteres (apenas letras minúsculas)
    caracteres = string.ascii_lowercase
    
    tentativas = 0
    tempo_inicio = time.time()
    
    print(f"Iniciando busca pela senha: '{senha_alvo}'...\n")
    
    # Testa comprimentos de 1 até tamanho_maximo
    for tamanho in range(1, tamanho_maximo + 1):
        # Dica 2: itertools.product gera as combinações em formato de tupla
        for combinacao in itertools.product(caracteres, repeat=tamanho):
            tentativas += 1
            
            # Dica 3: Unindo a tupla de caracteres em uma única string
            palavra_tentada = "".join(combinacao)
            
            # Exibe o progresso das tentativas
            print(f"Tentativa {tentativas}: {palavra_tentada}", end="\r")
            
            # Verifica se a senha foi encontrada
            if palavra_tentada == senha_alvo:
                tempo_total = time.time() - tempo_inicio
                print(f"\n\nSucesso! Senha encontrada: '{palavra_tentada}'")
                print(f"Total de tentativas: {tentativas}")
                print(f"Tempo decorrido: {tempo_total:.2f} segundos")
                return palavra_tentada
                
    print("\n\nSenha não encontrada no limite de caracteres definido.")
    return None

# --- Exemplo de uso ---
senha_teste = "cat"  # Senha curta de 3 caracteres
ataque_forca_bruta(senha_teste, tamanho_maximo=3)